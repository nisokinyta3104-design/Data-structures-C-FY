#include<iostream>
using namespace std;

int main()
{
    int stack[5];
    int top = -1;

    cout<<"\n Enter the 5 orders to cancel:\n";
    
    for (int i = 0; i < 5; i++)
        {   
         cin >> stack[++top];
        }
 cout <<"\n Recently cancelled orders:\n";

     while (top >= 0)
 {
     cout << stack[top] << endl;
     top--;
 }
    return 0;
    
 }

